       <string notr="true">/* 滚动画布 */
QScrollArea {
	border:none;
	border-radius: 5px; /* 设置QScrollArea的圆角 */
}
QScrollArea:vertical {
	border: none; /*无边框*/	
	background:rgba(30,30,30,0.5); /*透明背景*/
	width:12px; /*宽度*/
}

QScrollArea::handle:vertical {
	background: rgba(30,200,150,0.5); /*滑块颜色*/
	min-height: 20px; /*手柄最小高度*/
	max-height: 20px; /*手柄最大高度*/
	margin: 0 0px 0 0px; /*无外边框*/
	border-radius: 5px; /*圆角*/}
QScrollArea QScrollBar::add-line:vertical {
	height: 0px; /*隐藏增加行*/
}

QScrollArea QScrollBar::sub-line:vertical {
	height: 0 px; /*隐藏滚动条轨道*/
}
</string>
