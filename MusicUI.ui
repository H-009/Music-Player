    border: none;
}

QComboBox:disabled {
    background-color: rgb(30,30,30,0.1);
    color: rgb(30,200,150,0.5);
}

QComboBox:hover {
    background-color: rgba(30,200,150,0.3);
}


QComboBox::drop-down {
    width: 20px;
    border-left: none;
    image: url(:/ico/MusicIco/down.png);
}

QComboBox QAbstractItemView {
	border-radius: 5px;
    color: rgb(30,200,150);
    selection-background-color: rgba(30,200,150,0.4);
    outline: none;
    border: none;
}</string>
