        <pointsize>14</pointsize>
       </font>
      </property>
      <property name="styleSheet">
       <string notr="true">
QTextEdit {
    background-color: rgba(30, 30, 30,0.5); /* 设置背景颜色为浅灰色 */
    color:rgb(50, 50, 50);           /* 设置文本颜色为深灰色 */
    border-radius: 5px;        /* 设置边框圆角为5像素 */
    padding: 10px;             /* 设置内边距为10像素 */
}
QScrollBar:vertical {
    border: none; /*无边框*/
    background:rgb(0, 0, 0,0); /*透明背景*/
    width:12px; /*宽度*/
}

QScrollBar::handle:vertical {
	background: rgba(255, 255, 255,0.2); /*滑块颜色*/
    min-height: 20px; /*手柄最小高度*/
    max-height: 20px; /*手柄最大高度*/
    margin: 0 0px 0 0px; /*无外边框*/
    border-radius: 6px; /*圆角*/
}
QScrollBar::add-line:vertical {
    height: 0px; /*隐藏增加行*/
}

QScrollBar::sub-line:vertical {
    height: 0 px; /*隐藏滚动条轨道*/
}

QScrollBar::sub-page:vertical {
    background: rgba(0, 0, 0, 0); /*透明滚动条轨道*/
}

QScrollBar::add-page:vertical {
    background: rgba(0, 0, 0, 0); /*透明增加行*/
}
</string>
