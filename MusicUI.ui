       <property name="styleSheet">
        <string notr="true">QSlider {
    background-color: transparent;
}

/* 滑槽样式 - 改为细线设计 */
QSlider::groove:horizontal {
    height: 4px;                   /* 更细的滑槽 */
    background: rgba(30, 200, 150, 0.2);
    border-radius: 2px;            /* 小圆角 */
}

/* 滑块手柄 - 改为圆形突出设计 */
QSlider::handle:horizontal {
    background: rgba(30, 200, 150, 0.9);
    width: 16px;                  /* 缩小宽度 */
    height: 16px;                 /* 增加高度 */
    margin: -6px 0;               /* 使滑块突出于滑槽 */
    border-radius: 8px;           /* 完全圆形 */
}

/* 手柄悬停/按下效果（增强交互反馈） */
QSlider::handle:horizontal:hover {
	background: rgba(30,200,150,1);  /* 悬停透明度提升 */
}

/* 滑动区域颜色 - 调整为更细的线条 */
QSlider::sub-page:horizontal {
    background: rgba(30, 200, 150, 0.5);
    height: 4px;
    border-radius: 2px;
}

QSlider::add-page:horizontal {
    background: rgba(30, 200, 150, 0.1);
    height: 4px;
    border-radius: 2px;
}</string>
       </property>
       <property name="maximum">
        <number>100</number>
       </property>
       <property name="orientation">
        <enum>Qt::Horizontal</enum>
       </property>
